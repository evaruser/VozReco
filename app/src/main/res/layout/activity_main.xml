<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#182A57"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#182A57"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Encabezado institucional -->
        <TextView
            android:id="@+id/txtMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CESBA"
            android:textColor="#F0B323"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityHeading="true"
            android:text="VoiceControl"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asistente controlado por voz"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Estado del reconocedor -->
        <TextView
            android:id="@+id/txtEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Estado: iniciando..."
            android:textColor="#F0B323"
            android:textSize="18sp" />

        <!-- Botón grande de reconocimiento: fácil de encontrar al tacto -->
        <Button
            android:id="@+id/btnEscuchar"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="15dp"
            android:backgroundTint="#F0B323"
            android:contentDescription="Toca para hablar. Da una orden de voz"
            android:text="TOCA PARA HABLAR"
            android:textColor="#111111"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Cancelación -->
        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:text="CANCELAR"
            android:textSize="20sp" />

        <!-- Resultado -->
        <TextView
            android:id="@+id/lblReconocido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="TEXTO RECONOCIDO"
            android:textColor="#F0B323"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtReconocido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="Esperando instrucciones..."
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <!-- Respuesta del asistente -->
        <TextView
            android:id="@+id/lblRespuesta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="RESPUESTA DEL ASISTENTE"
            android:textColor="#F0B323"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRespuesta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="Sin respuesta."
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <!-- Calculadora interna -->
        <LinearLayout
            android:id="@+id/panelCalculadora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#314B91"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="CALCULADORA"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/numA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Primer número"
                android:importantForAutofill="no"
                android:inputType="numberDecimal|numberSigned"
                android:textColor="#FFFFFF"
                android:textColorHint="#CCCCCC" />

            <EditText
                android:id="@+id/numB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Segundo número"
                android:importantForAutofill="no"
                android:inputType="numberDecimal|numberSigned"
                android:textColor="#FFFFFF"
                android:textColorHint="#CCCCCC" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSumar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="Sumar"
                    android:text="+"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btnRestar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="Restar"
                    android:text="−"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btnMultiplicar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="Multiplicar"
                    android:text="×"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btnDividir"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="Dividir"
                    android:text="÷"
                    android:textSize="22sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCerrarCalc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CERRAR CALCULADORA" />
        </LinearLayout>

        <Button
            android:id="@+id/btnComandos"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="VER LISTA DE COMANDOS"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtComandos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtNota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Toca el botón grande y pronuncia una instrucción. Di «ayuda» para conocer los comandos. El servicio de reconocimiento puede requerir Internet."
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
